rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile document rules: Private to the account owner only
    match /users/{userId} {
      allow read, create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;

      // Subcollections or stats
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Public Leaderboard Collection: Read-only for everyone, write-only by the specific account owner
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // User game stats rules
    match /user_game_stats/{statId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Games catalog rules
    match /games/{gameId} {
      allow read: if resource.data.isAdminOnly != true || (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      allow write: if true;
    }

    // Game comments rules: anyone can read, authenticated users can post, anyone can update likes
    match /gameComments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if true;
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Standalone user game save states rules (Generic progressData per gameId)
    match /user_game_saves/{saveId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (
        request.resource.data.userId == request.auth.uid ||
        (resource != null && resource.data.userId == request.auth.uid)
      );
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // News articles: high security read, admin can write, authenticated can like
    match /newsArticles/{newsId} {
      allow read: if resource.data.isAdminOnly != true || (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
      allow create, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
      allow update: if (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true) || 
                    (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']));
    }
  }
}
