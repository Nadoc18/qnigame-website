      {
        "name": "index.html",
        "language": "html",
        "content": "<!DOCTYPE html>\n<html dir=\"rtl\" lang=\"he\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>מרוץ הברכות</title>\n  <style>\n    body { font-family: system-ui, sans-serif; background: #064e3b; color: #ecfdf5; padding: 20px; direction: rtl; text-align: center; }\n    #game-card { max-width: 550px; margin: 0 auto; background: #047857; padding: 24px; border-radius: 20px; border: 3px solid #34d399; }\n    .food-display { font-size: 4rem; margin: 15px 0; }\n    .btn-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 15px; }\n    .b-btn { padding: 12px; background: #065f46; border: 2px solid #a7f3d0; color: white; font-size: 1.1rem; font-weight: bold; border-radius: 12px; cursor: pointer; }\n    .b-btn:hover { background: #047857; border-color: #f59e0b; }\n    #feedback { margin-top: 15px; font-size: 1.2rem; font-weight: bold; min-height: 30px; }\n  </style>\n</head>\n<body>\n  <div id=\"game-card\">\n    <h1>🍏 מרוץ הברכות והכשרות 🍎</h1>\n    <h2>מה הברכה הראשונה על המאכל?</h2>\n    <div class=\"food-display\" id=\"food-icon\">🍎</div>\n    <div id=\"food-name\" style=\"font-size:1.4rem; font-weight:bold;\">תפוח עץ מתוק</div>\n    <div class=\"btn-grid\">\n      <button class=\"b-btn\" onclick=\"check('העץ')\">🌳 בורא פרי העץ</button>\n      <button class=\"b-btn\" onclick=\"check('האדמה')\">🌱 בורא פרי האדמה</button>\n      <button class=\"b-btn\" onclick=\"check('שהכל')\">💧 שהכל נהיה בדברו</button>\n      <button class=\"b-btn\" onclick=\"check('המוציא')\">🍞 המוציא לחם</button>\n    </div>\n    <div id=\"feedback\"></div>\n  </div>\n  <script>\n    const foods = [\n      { name: 'תפוח עץ מתוק', icon: '🍎', blessing: 'העץ' },\n      { name: 'מלפפון ירוק', icon: '🥒', blessing: 'האדמה' },\n      { name: 'כוס מים צלולים', icon: '💧', blessing: 'שהכל' },\n      { name: 'פרוסת חלה טרייה', icon: '🍞', blessing: 'המוציא' }\n    ];\n    let idx = 0;\n    function check(b) {\n      const fb = document.getElementById('feedback');\n      if (b === foods[idx].blessing) {\n        fb.innerText = '✅ נכון מאוד! כל הכבוד!';\n        fb.style.color = '#a7f3d0';\n      } else {\n        fb.innerText = '❌ לא מדויק, נסה שוב!';\n        fb.style.color = '#fca5a5';\n      }\n      setTimeout(() => {\n        idx = (idx + 1) % foods.length;\n        document.getElementById('food-icon').innerText = foods[idx].icon;\n        document.getElementById('food-name').innerText = foods[idx].name;\n        fb.innerText = '';\n      }, 1200);\n    }\n  </script>\n</body>\n</html>"
      }
    ]
  },
