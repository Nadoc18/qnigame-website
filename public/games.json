      {
        "name": "index.html",
        "language": "html",
        "content": "<!DOCTYPE html>\n<html dir=\"rtl\" lang=\"he\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>טריוויה יהודית</title>\n  <style>\n    body { font-family: system-ui, sans-serif; background: #0f172a; color: #f8fafc; margin: 0; padding: 20px; direction: rtl; text-align: center; }\n    #game-container { max-width: 600px; margin: 0 auto; background: #1e293b; border-radius: 16px; padding: 24px; border: 2px solid #f59e0b; }\n    h1 { color: #f59e0b; margin-bottom: 10px; }\n    .stats { display: flex; justify-content: space-around; background: #0f172a; padding: 10px; border-radius: 8px; font-weight: bold; margin-bottom: 20px; }\n    .opt-btn { display: block; width: 100%; padding: 14px; margin: 8px 0; background: #334155; color: white; border: 2px solid #475569; border-radius: 10px; font-size: 1rem; cursor: pointer; text-align: right; font-weight: bold; }\n    .opt-btn:hover { background: #475569; border-color: #f59e0b; }\n    .opt-btn.correct { background: #166534; border-color: #22c55e; }\n    .opt-btn.wrong { background: #991b1b; border-color: #ef4444; }\n    #exp { background: #1e1b4b; border-right: 4px solid #818cf8; padding: 12px; margin-top: 15px; border-radius: 8px; text-align: right; display: none; }\n    #next-btn { width: 100%; padding: 12px; background: #f59e0b; color: #0f172a; border: none; font-weight: bold; border-radius: 10px; cursor: pointer; margin-top: 12px; display: none; }\n  </style>\n</head>\n<body>\n  <div id=\"game-container\">\n    <h1>✨ טריוויה יהודית - אלופי התנ\"ך ✨</h1>\n    <div class=\"stats\">\n      <div>ניקוד: <span id=\"score\">0</span></div>\n      <div>רצף: <span id=\"streak\">🔥 0</span></div>\n    </div>\n    <h3 id=\"q-cat\" style=\"color:#38bdf8;\">פרשת השבוע</h3>\n    <h2 id=\"q-text\">טוען שאלה...</h2>\n    <div id=\"opts\"></div>\n    <div id=\"exp\"></div>\n    <button id=\"next-btn\">השאלה הבאה ➔</button>\n  </div>\n  <script>\n    const questions = [\n      { q: \"כמה ספרים יש בחמישה חומשי תורה?\", cat: \"תורה\", opts: [\"3 ספרים\", \"5 ספרים\", \"7 ספרים\", \"12 ספרים\"], c: 1, exp: \"חמישה חומשי תורה: בראשית, שמות, ויקרא, במדבר, דברים.\" },\n      { q: \"מה מברכים על לחם לפני האכילה?\", cat: \"ברכות\", opts: [\"בורא פרי העץ\", \"שהכל נהיה בדברו\", \"המוציא לחם מן הארץ\", \"בורא מיני מזונות\"], c: 2, exp: \"ברכת המוציא היא הברכה המיוחדת על לחם מחמשת מיני דגן.\" },\n      { q: \"איזה חג נקרא גם 'חג הקציר' ו'יום הביכורים'?\", cat: \"חגים\", opts: [\"פסח\", \"שבועות\", \"סוכות\", \"ראש השנה\"], c: 1, exp: \"חג השבועות חל בזמן קציר החטים והבאת הביכורים.\" },\n      { q: \"מי הנהיג את בני ישראל ביציאת מצרים?\", cat: \"תנ\"ך\", opts: [\"אברהם אבינו\", \"משה רבנו\", \"יהושע בן נון\", \"דוד המלך\"], c: 1, exp: \"משה רבנו הנהיג את עמו ביציאת מצרים וקבלת התורה.\" }\n    ];\n    let cur = 0, score = 0, streak = 0;\n    function loadQ() {\n      const q = questions[cur];\n      document.getElementById('q-cat').innerText = q.cat;\n      document.getElementById('q-text').innerText = q.q;\n      document.getElementById('exp').style.display = 'none';\n      document.getElementById('next-btn').style.display = 'none';\n      const div = document.getElementById('opts');\n      div.innerHTML = '';\n      q.opts.forEach((o, i) => {\n        const b = document.createElement('button');\n        b.className = 'opt-btn';\n        b.innerText = o;\n        b.onclick = () => {\n          document.querySelectorAll('.opt-btn').forEach((btn, idx) => {\n            btn.disabled = true;\n            if (idx === q.c) btn.classList.add('correct');\n            else if (idx === i) btn.classList.add('wrong');\n          });\n          if (i === q.c) { score += 100; streak++; }\n          else streak = 0;\n          document.getElementById('score').innerText = score;\n          document.getElementById('streak').innerText = '🔥 ' + streak;\n          document.getElementById('exp').innerText = '💡 ' + q.exp;\n          document.getElementById('exp').style.display = 'block';\n          document.getElementById('next-btn').style.display = 'block';\n        };\n        div.appendChild(b);\n      });\n    }\n    document.getElementById('next-btn').onclick = () => {\n      cur = (cur + 1) % questions.length;\n      loadQ();\n    };\n    loadQ();\n  </script>\n</body>\n</html>"
      }
    ]
  },
