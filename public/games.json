        "content": "<!DOCTYPE html>\n<html dir=\"rtl\" lang=\"he\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>מילון התנ\"ך</title>\n  <style>\n    body { font-family: system-ui, sans-serif; background: #2e1065; color: #f3e8ff; padding: 20px; direction: rtl; text-align: center; }\n    #wordle-card { max-width: 500px; margin: 0 auto; background: #4c1d95; padding: 20px; border-radius: 20px; border: 2px solid #a855f7; }\n    .grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 8px; margin: 20px 0; dir: rtl; }\n    .cell { width: 50px; height: 50px; border: 2px solid #7e22ce; display: flex; align-items: center; justify-content: center; font-size: 1.5rem; font-weight: bold; background: #3b0764; border-radius: 8px; margin: 0 auto; }\n    .correct { background: #15803d; border-color: #22c55e; }\n    input { width: 80%; padding: 12px; font-size: 1.2rem; text-align: center; border-radius: 10px; border: none; margin-bottom: 10px; font-weight: bold; }\n    button { padding: 12px 24px; background: #a855f7; color: white; font-weight: bold; border: none; border-radius: 10px; cursor: pointer; }\n  </style>\n</head>\n<body>\n  <div id=\"wordle-card\">\n    <h1>📖 מילון התנ\"ך היומי 📖</h1>\n    <p>מצא מילה מפסוקי התנ\"ך (5 אותיות)</p>\n    <div class=\"grid\" id=\"grid\">\n      <div class=\"cell\">?</div><div class=\"cell\">?</div><div class=\"cell\">?</div><div class=\"cell\">?</div><div class=\"cell\">?</div>\n    </div>\n    <input type=\"text\" id=\"input\" maxlength=\"5\" placeholder=\"הכנס 5 אותיות...\">\n    <br>\n    <button onclick=\"guess()\">בדוק ניחוש ↵</button>\n    <div id=\"msg\" style=\"margin-top:15px; font-weight:bold;\"></div>\n  </div>\n  <script>\n    const secret = \"אברהם\";\n    function guess() {\n      const val = document.getElementById('input').value.trim();\n      if (val.length !== 5) { alert('הכנס מילה בת 5 אותיות!'); return; }\n      const cells = document.querySelectorAll('.cell');\n      for(let i=0; i<5; i++) {\n        cells[i].innerText = val[i];\n        if (val[i] === secret[i]) cells[i].className = 'cell correct';\n      }\n      if (val === secret) {\n        document.getElementById('msg').innerText = '🎉 כל הכבוד! גילית את שם אברהם אבינו!';\n      } else {\n        document.getElementById('msg').innerText = '💡 רמז: מדובר באחד מאבות האומה!';\n      }\n    }\n  </script>\n</body>\n</html>"
      }
    ]
